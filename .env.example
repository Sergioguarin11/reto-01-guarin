# Proveedor del modelo (solo backend; nunca en el front, el repo ni los logs)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.1-flash-lite,gemini-3.5-flash
# Nivel de razonamiento de Gemini: low (más rápido) o vacío (por defecto del modelo)
LLM_THINKING=low

# Servidor
PORT=3000
# Opcional: si se define, el chat pide esta clave (header x-access-key)
ACCESS_KEY=

# Topes de costo y robustez
MAX_ITERACIONES=25
MAX_TOKENS_SESION=300000
MAX_TURNOS_DIA=300
LLM_TIMEOUT_MS=60000

# Opcional: fija la fecha de ejecución (YYYY-MM-DD) para pruebas reproducibles de vigencias
FECHA_EJECUCION=

# Canal Telegram (opcional). Sin token, el canal queda apagado.
TELEGRAM_BOT_TOKEN=
# IDs numéricos de Telegram autorizados, separados por coma. Vacío = cualquiera (con los topes diarios).
TELEGRAM_USUARIOS=
# Solo en producción: con PUBLIC_URL y secreto el bot usa webhook; sin ellos usa polling (local).
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_URL=
